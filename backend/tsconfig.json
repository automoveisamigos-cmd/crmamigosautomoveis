{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/config/**/*",
    "src/controllers/**/*",
    "src/middlewares/**/*",
    "src/routes/**/*",
    "src/services/**/*"
  ]
}
